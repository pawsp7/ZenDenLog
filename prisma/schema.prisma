generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String      @unique
  passwordHash  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  timeEntries   TimeEntry[]
  ownedShifts   Shift[]     @relation("ShiftOwner")
  createdShifts Shift[]     @relation("ShiftCreatedBy")
  givenUpShifts Shift[]     @relation("ShiftGivenUpBy")
  claimedShifts Shift[]     @relation("ShiftClaimedBy")
}

model TimeEntry {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id])
  checkInAt  DateTime
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, checkInAt])
}

model Shift {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  location        String?
  notes           String?
  startAt         DateTime
  endAt           DateTime
  status          String    @default("SCHEDULED")
  recurrence      String    @default("NONE")
  recurrenceUntil DateTime?
  seriesId        String?
  ownerId         String?   @db.ObjectId
  owner           User?     @relation("ShiftOwner", fields: [ownerId], references: [id])
  createdById     String    @db.ObjectId
  createdBy       User      @relation("ShiftCreatedBy", fields: [createdById], references: [id])
  givenUpById     String?   @db.ObjectId
  givenUpBy       User?     @relation("ShiftGivenUpBy", fields: [givenUpById], references: [id])
  claimedById     String?   @db.ObjectId
  claimedBy       User?     @relation("ShiftClaimedBy", fields: [claimedById], references: [id])
  givenUpAt       DateTime?
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startAt, status])
  @@index([ownerId, startAt])
  @@index([seriesId])
  @@index([status, startAt])
}
